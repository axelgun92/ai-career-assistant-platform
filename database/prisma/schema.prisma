generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OpportunityStatus {
  DISCOVERED
  NORMALIZED
  EVALUATED
  RECOMMENDED
  SAVED
  APPLIED
  REJECTED_BY_USER
  CLOSED
  ARCHIVED
}

enum OpportunityUserActionType {
  SAVE
  MARK_APPLIED
  DISMISS
  ARCHIVE
  RESTORE
}

enum SourceType {
  MANUAL
  BROWSER_EXTENSION
  PUBLIC_SEARCH
  ATS
  API
  COMPANY_WATCHLIST
  OTHER
}

enum DuplicateDecision {
  MATCH
  PROBABLE_MATCH
  NO_MATCH
}

enum EvaluationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum SemanticOperationStatus {
  SUCCESS
  VALIDATION_FAILURE
  PROVIDER_FAILURE
  TIMEOUT
}

enum EvidenceLevel {
  CONFIRMED
  STRONG_EVIDENCE
  POSSIBLE
  UNKNOWN
  CONFLICTING
}

enum ProvenanceKind {
  DIRECT
  DETERMINISTIC
}

enum EvidenceOrigin {
  EXPLICIT
  DERIVED
  INFERRED
}

enum ContradictionResolutionStatus {
  UNRESOLVED
  RESOLVED
}

model Company {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  normalizedName  String?
  brand           String?
  industry        String?
  headquarters    String?
  companySize     String?
  parentCompanyId String?       @db.Uuid
  parentCompany   Company?      @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id], onDelete: SetNull)
  subsidiaries    Company[]     @relation("CompanyHierarchy")
  opportunities   Opportunity[]
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  @@index([normalizedName])
  @@index([parentCompanyId])
}

model Opportunity {
  id                String    @id @default(uuid()) @db.Uuid
  domain            String?
  externalListingId String?
  atsRequisitionId  String?
  canonicalUrl      String?   @db.Text
  applicationUrl    String?   @db.Text
  originalSource    String?
  discoveredAt      DateTime  @default(now()) @db.Timestamptz(3)
  sourceUpdatedAt   DateTime? @db.Timestamptz(3)
  firstSeenAt       DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(3)

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  title          String?
  department     String?
  employmentType String?
  seniority      String?

  location             String?
  remoteStatus         String?
  timeZoneRequirements String?

  salaryMin         Decimal? @db.Decimal(12, 2)
  salaryMax         Decimal? @db.Decimal(12, 2)
  salaryText        String?
  bonus             String?
  equity            String?
  currency          String?
  compensationNotes String?  @db.Text

  postingDate DateTime?   @db.Timestamptz(3)
  closingDate DateTime?   @db.Timestamptz(3)
  source      String?
  sourceType  SourceType?
  atsPlatform String?

  jobDescription   String? @db.Text
  responsibilities String? @db.Text
  requirements     String? @db.Text
  benefits         String? @db.Text
  additionalNotes  String? @db.Text

  status                OpportunityStatus          @default(DISCOVERED)
  sourceRecords         SourceRecord[]
  fieldProvenance       FieldProvenance[]
  evaluations           Evaluation[]
  evidenceRecords       EvidenceRecord[]
  recommendations       Recommendation[]
  evaluationAdmissions  EvaluationAdmission[]
  deferredEvaluations   DeferredEvaluation[]
  userActions           OpportunityUserAction[]
  semanticOperations    SemanticOperationAttempt[]
  duplicateReferences   DuplicateReference[]       @relation("DuplicateReferenceSource")
  referencedAsDuplicate DuplicateReference[]       @relation("DuplicateReferenceTarget")
  createdAt             DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                   @updatedAt @db.Timestamptz(3)

  @@index([domain, status])
  @@index([companyId])
  @@index([externalListingId])
  @@index([atsRequisitionId])
  @@index([postingDate])
  @@index([discoveredAt(sort: Desc), id(sort: Desc)])
  @@index([status, discoveredAt])
  @@index([sourceType])
  @@index([updatedAt])
}

model SourceRecord {
  id                 String                     @id @default(uuid()) @db.Uuid
  opportunityId      String?                    @db.Uuid
  opportunity        Opportunity?               @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  source             String
  sourceType         SourceType
  sourceUrl          String?                    @db.Text
  // This source's own application link; Opportunity.applicationUrl is the
  // canonical choice across sources.
  applicationUrl     String?                    @db.Text
  externalId         String?
  requisitionId      String?
  rawTitle           String?
  rawCompany         String?
  rawLocation        String?
  rawDescription     String?                    @db.Text
  rawSalaryText      String?
  rawEmploymentType  String?
  rawPostingDate     String?
  sourceMetadata     Json?
  rawPayload         Json?
  discoveredAt       DateTime                   @default(now()) @db.Timestamptz(3)
  lastObservedAt     DateTime                   @default(now()) @db.Timestamptz(3)
  normalizedAt       DateTime?                  @db.Timestamptz(3)
  fieldProvenance    FieldProvenance[]
  evidenceRecords    EvidenceRecord[]
  semanticOperations SemanticOperationAttempt[]
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @db.Timestamptz(3)

  @@index([opportunityId])
  @@index([source, externalId])
  @@index([requisitionId])
}

model FieldProvenance {
  id              String           @id @default(uuid()) @db.Uuid
  opportunityId   String           @db.Uuid
  opportunity     Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sourceRecordId  String?          @db.Uuid
  sourceRecord    SourceRecord?    @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)
  fieldName       String
  sourceField     String
  kind            ProvenanceKind
  normalizedValue Json?
  sourceReference String?          @db.Text
  sourceText      String?          @db.Text
  collectedAt     DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  evidenceRecords EvidenceRecord[]

  @@index([opportunityId, fieldName])
  @@index([sourceRecordId])
}

model DuplicateReference {
  id                   String            @id @default(uuid()) @db.Uuid
  opportunityId        String            @db.Uuid
  opportunity          Opportunity       @relation("DuplicateReferenceSource", fields: [opportunityId], references: [id], onDelete: Cascade)
  relatedOpportunityId String            @db.Uuid
  relatedOpportunity   Opportunity       @relation("DuplicateReferenceTarget", fields: [relatedOpportunityId], references: [id], onDelete: Cascade)
  decision             DuplicateDecision
  confidence           Decimal?          @db.Decimal(5, 4)
  evidence             Json?
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([opportunityId, relatedOpportunityId])
  @@index([relatedOpportunityId])
}

model UserProfile {
  id                      String               @id @default(uuid()) @db.Uuid
  label                   String
  version                 Int                  @default(1)
  contentHash             String?
  careerGoals             Json?
  experience              Json?
  skills                  Json?
  transferableSkills      Json?
  locationPreferences     Json?
  compensationPreferences Json?
  workPreferences         Json?
  companyPreferences      Json?
  domainPreferences       Json?
  evaluations             Evaluation[]
  activeFor               ActiveUserProfile[]
  deferredEvaluations     DeferredEvaluation[]
  createdAt               DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime             @updatedAt @db.Timestamptz(3)

  @@unique([label, version])
  @@unique([label, contentHash])
}

// The profile version the user explicitly chose for new evaluations in a
// domain. Activation only moves this pointer; UserProfile rows stay immutable.
model ActiveUserProfile {
  domain        String      @id
  userProfileId String      @db.Uuid
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  activatedAt   DateTime    @default(now()) @db.Timestamptz(3)

  @@index([userProfileId])
}

model Evaluation {
  id                 String                     @id @default(uuid()) @db.Uuid
  opportunityId      String                     @db.Uuid
  opportunity        Opportunity                @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userProfileId      String?                    @db.Uuid
  userProfile        UserProfile?               @relation(fields: [userProfileId], references: [id], onDelete: SetNull)
  domain             String
  status             EvaluationStatus           @default(PENDING)
  evaluationVersion  String
  domainVersion      String
  ruleVersion        String
  promptVersion      String?
  userProfileVersion Int?
  executionMetadata  Json?
  domainResult       Json?
  stageResults       StageResult[]
  evidenceRecords    EvidenceRecord[]
  contradictions     Contradiction[]
  recommendation     Recommendation?
  task               EvaluationTask?
  semanticOperations SemanticOperationAttempt[]
  admission          EvaluationAdmission?
  errorMessage       String?                    @db.Text
  startedAt          DateTime?                  @db.Timestamptz(3)
  completedAt        DateTime?                  @db.Timestamptz(3)
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @db.Timestamptz(3)

  @@index([opportunityId, createdAt])
  @@index([userProfileId])
  @@index([domain, status])
}

model AiModelPricingConfiguration {
  id                              String                     @id @default(uuid()) @db.Uuid
  provider                        String
  model                           String
  version                         String
  currency                        String
  inputCostPerMillionTokens       Decimal                    @db.Decimal(18, 6)
  cachedInputCostPerMillionTokens Decimal                    @db.Decimal(18, 6)
  outputCostPerMillionTokens      Decimal                    @db.Decimal(18, 6)
  longContextThresholdTokens      Int?
  longContextInputMultiplier      Decimal                    @db.Decimal(8, 4)
  longContextOutputMultiplier     Decimal                    @db.Decimal(8, 4)
  effectiveFrom                   DateTime                   @db.Timestamptz(3)
  effectiveTo                     DateTime?                  @db.Timestamptz(3)
  semanticOperations              SemanticOperationAttempt[]
  createdAt                       DateTime                   @default(now()) @db.Timestamptz(3)

  @@unique([provider, model, version])
  @@index([provider, model, effectiveFrom])
}

model StageResult {
  id              String           @id @default(uuid()) @db.Uuid
  evaluationId    String           @db.Uuid
  evaluation      Evaluation       @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  stageId         String
  position        Int
  status          EvaluationStatus @default(PENDING)
  stageVersion    String
  ruleVersion     String
  promptVersion   String?
  attempt         Int              @default(1)
  retryable       Boolean          @default(false)
  failureCode     String?
  result          Json?
  errorMessage    String?          @db.Text
  evidenceRecords EvidenceRecord[]
  contradictions  Contradiction[]
  startedAt       DateTime?        @db.Timestamptz(3)
  completedAt     DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([evaluationId, stageId])
  @@unique([evaluationId, position])
}

model EvidenceRecord {
  id              String           @id @default(uuid()) @db.Uuid
  opportunityId   String           @db.Uuid
  opportunity     Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  evaluationId    String?          @db.Uuid
  evaluation      Evaluation?      @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  stageResultId   String?          @db.Uuid
  stageResult     StageResult?     @relation(fields: [stageResultId], references: [id], onDelete: Cascade)
  stageId         String?
  referenceId     String
  criterionId     String?
  claim           String           @db.Text
  sourceType      String
  sourceRecordId  String?          @db.Uuid
  sourceRecord    SourceRecord?    @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)
  provenanceId    String?          @db.Uuid
  provenance      FieldProvenance? @relation(fields: [provenanceId], references: [id], onDelete: SetNull)
  sourceField     String?
  sourceReference String?          @db.Text
  sourceText      String?          @db.Text
  evidenceType    String
  origin          EvidenceOrigin
  evidenceLevel   EvidenceLevel
  collectedAt     DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)

  @@index([opportunityId])
  @@index([evaluationId, stageId])
  @@index([stageResultId])
  @@index([evaluationId, referenceId])
  @@index([sourceRecordId])
  @@index([provenanceId])
  @@index([evidenceLevel])
}

model Contradiction {
  id               String                        @id @default(uuid()) @db.Uuid
  evaluationId     String                        @db.Uuid
  evaluation       Evaluation                    @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  stageResultId    String?                       @db.Uuid
  stageResult      StageResult?                  @relation(fields: [stageResultId], references: [id], onDelete: Cascade)
  claimA           String                        @db.Text
  claimB           String                        @db.Text
  interpretation   String                        @db.Text
  relevantField    String?
  stageId          String?
  significance     String?
  evidenceIdsA     String[]                      @db.Uuid
  evidenceIdsB     String[]                      @db.Uuid
  resolutionStatus ContradictionResolutionStatus @default(UNRESOLVED)
  resolutionNote   String?                       @db.Text
  resolvedAt       DateTime?                     @db.Timestamptz(3)
  createdAt        DateTime                      @default(now()) @db.Timestamptz(3)

  @@index([evaluationId])
  @@index([stageResultId])
}

model Recommendation {
  id                 String      @id @default(uuid()) @db.Uuid
  opportunityId      String      @db.Uuid
  opportunity        Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  evaluationId       String      @unique @db.Uuid
  evaluation         Evaluation  @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  decision           String
  scoreSummary       Json?
  strongestPositives Json?
  strongestConcerns  Json?
  reviewConditions   Json?
  unknowns           Json?
  contradictions     Json?
  evidenceReferences String[]
  explanation        String      @db.Text
  evaluationVersion  String
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)

  @@index([opportunityId, createdAt])
  @@index([decision])
}

model EvaluationTask {
  id             String           @id @default(uuid()) @db.Uuid
  evaluationId   String           @unique @db.Uuid
  evaluation     Evaluation       @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  status         EvaluationStatus @default(PENDING)
  attempt        Int              @default(0)
  maxAttempts    Int
  availableAt    DateTime         @default(now()) @db.Timestamptz(3)
  claimedAt      DateTime?        @db.Timestamptz(3)
  leaseExpiresAt DateTime?        @db.Timestamptz(3)
  startedAt      DateTime?        @db.Timestamptz(3)
  completedAt    DateTime?        @db.Timestamptz(3)
  errorCode      String?
  errorMessage   String?          @db.Text
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([leaseExpiresAt])
}

model SemanticOperationAttempt {
  id                     String                       @id @default(uuid()) @db.Uuid
  evaluationId           String                       @db.Uuid
  evaluation             Evaluation                   @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  opportunityId          String                       @db.Uuid
  opportunity            Opportunity                  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  domain                 String
  sourceRecordId         String?                      @db.Uuid
  sourceRecord           SourceRecord?                @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)
  jobSource              String?
  operationId            String
  promptVersion          String
  attempt                Int
  provider               String
  model                  String
  status                 SemanticOperationStatus
  inputTokens            Int?
  outputTokens           Int?
  cachedInputTokens      Int?
  reasoningTokens        Int?
  totalTokens            Int?
  estimatedCost          Decimal?                     @db.Decimal(18, 12)
  pricingConfigurationId String?                      @db.Uuid
  pricingConfiguration   AiModelPricingConfiguration? @relation(fields: [pricingConfigurationId], references: [id], onDelete: Restrict)
  durationMs             Int
  providerRequestId      String?
  errorCode              String?
  errorMessage           String?                      @db.Text
  createdAt              DateTime                     @default(now()) @db.Timestamptz(3)

  @@unique([evaluationId, operationId, attempt])
  @@index([evaluationId, createdAt])
  @@index([opportunityId, createdAt])
  @@index([domain, createdAt])
  @@index([sourceRecordId])
  @@index([pricingConfigurationId])
}

// Explicit user lifecycle actions only. Evaluations and automatic system
// lifecycle sync never write here.
model OpportunityUserAction {
  id            String                    @id @default(uuid()) @db.Uuid
  opportunityId String                    @db.Uuid
  opportunity   Opportunity               @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  action        OpportunityUserActionType
  fromStatus    OpportunityStatus
  toStatus      OpportunityStatus
  createdAt     DateTime                  @default(now()) @db.Timestamptz(3)

  @@index([opportunityId, createdAt])
}

enum BudgetPeriodType {
  CALENDAR_MONTH
}

enum DeferredEvaluationStatus {
  DEFERRED
  RESUMED
  CANCELLED
}

// Request integrity (no money involved): one row per evaluation request the
// product admitted to the queue. A live admission is consumed only inside the
// transaction that creates its Evaluation (enqueueAdmitted), or abandoned;
// the two are mutually exclusive, so an abandoned admission can never produce
// an Evaluation.
model EvaluationAdmission {
  id              String                       @id @default(uuid()) @db.Uuid
  opportunityId   String                       @db.Uuid
  opportunity     Opportunity                  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  evaluationId    String?                      @unique @db.Uuid
  evaluation      Evaluation?                  @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  reservation     EvaluationBudgetReservation?
  resumedDeferral DeferredEvaluation?
  createdAt       DateTime                     @default(now()) @db.Timestamptz(3)
  attachedAt      DateTime?                    @db.Timestamptz(3)
  abandonedAt     DateTime?                    @db.Timestamptz(3)

  @@index([opportunityId, createdAt])
  @@index([evaluationId, abandonedAt])
}

// The user's budget (a single row, id "global"). Editing it never touches
// usage or cost records.
model BudgetSetting {
  id                   String           @id
  amount               Decimal          @db.Decimal(18, 6)
  currency             String
  periodType           BudgetPeriodType @default(CALENDAR_MONTH)
  timeZone             String           @default("UTC")
  enforced             Boolean          @default(true)
  reservePerEvaluation Decimal          @db.Decimal(18, 6)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(3)
}

// The budget held for an admitted evaluation before its actual cost is
// known. Written only when a budget is configured; never updated. The hold
// is derived from persisted attempt costs, so reconciliation rewrites nothing.
model EvaluationBudgetReservation {
  id          String              @id @default(uuid()) @db.Uuid
  admissionId String              @unique @db.Uuid
  admission   EvaluationAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  amount      Decimal             @db.Decimal(18, 12)
  currency    String
  enforced    Boolean
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
}

// An evaluation request that was not started because budget was unavailable.
// It never reached the queue; the opportunity lifecycle is untouched. The
// profile version resolved at request time is pinned and used on resume.
model DeferredEvaluation {
  id                 String                   @id @default(uuid()) @db.Uuid
  opportunityId      String                   @db.Uuid
  opportunity        Opportunity              @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  domain             String
  userProfileId      String?                  @db.Uuid
  userProfile        UserProfile?             @relation(fields: [userProfileId], references: [id], onDelete: SetNull)
  userProfileVersion Int?
  status             DeferredEvaluationStatus @default(DEFERRED)
  reasonCode         String
  reasonSnapshot     Json
  lastCheckedAt      DateTime                 @db.Timestamptz(3)
  // The admission that resumed this request. Its evaluation is attached
  // atomically by enqueueAdmitted(); if the admission is abandoned instead,
  // the request returns to DEFERRED.
  resumedAdmissionId String?                  @unique @db.Uuid
  resumedAdmission   EvaluationAdmission?     @relation(fields: [resumedAdmissionId], references: [id], onDelete: SetNull)
  resumedAt          DateTime?                @db.Timestamptz(3)
  cancelledAt        DateTime?                @db.Timestamptz(3)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([opportunityId, status])
}
