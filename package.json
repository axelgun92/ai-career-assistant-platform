{
  "name": "ai-career-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ai-career/web dev",
    "build": "pnpm --filter @ai-career/web build",
    "start": "pnpm --filter @ai-career/web start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "worker:evaluations": "tsx apps/web/src/server/evaluation-worker-cli.ts",
    "worker:evaluations:once": "tsx apps/web/src/server/evaluation-worker-cli.ts --once",
    "profile:import:customer-success": "tsx apps/web/src/server/profile-import/import-customer-success-profile-cli.ts",
    "prisma:format": "prisma format --config database/prisma.config.ts",
    "prisma:validate": "prisma validate --config database/prisma.config.ts",
    "prisma:generate": "prisma generate --config database/prisma.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "dotenv": "17.4.2",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "26.1.0",
    "prisma": "7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
