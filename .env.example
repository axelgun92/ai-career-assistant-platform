# AI Career Platform — copy to .env and fill in. Never commit .env.
# `pnpm app:doctor` checks this configuration (it never prints values).

# ---------------------------------------------------------------------------
# Required for the product to start (web app, worker, scripts, tests).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_career_assistant?schema=public

# ---------------------------------------------------------------------------
# Required for real AI evaluation (paid provider calls). Leave the key empty
# to run the product without AI: everything works except requesting an
# evaluation, which then explains that AI is not configured. The worker
# refuses to start without it.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-terra
AI_MAX_OUTPUT_TOKENS=12000
AI_RETRY_LIMIT=1
AI_CALL_BUDGET=16
AI_REQUEST_TIMEOUT_MS=120000

# Queue settings. EVALUATION_JOB_MAX_ATTEMPTS is needed to queue evaluations;
# the worker also needs the lease and poll interval. Run exactly one worker.
EVALUATION_JOB_MAX_ATTEMPTS=3
EVALUATION_JOB_LEASE_SECONDS=300
EVALUATION_WORKER_POLL_MS=1000

# ---------------------------------------------------------------------------
# Optional. These defaults are the accepted production execution and pricing
# configuration; change them only deliberately (queued evaluations record the
# policy and pricing versions they were queued with).
# ---------------------------------------------------------------------------
AI_DEFAULT_REASONING_EFFORT=medium
AI_EXECUTION_POLICY_VERSION=customer-success-semantic-policy-v3-mixed-terra-luna
AI_OPERATION_EXECUTION_OVERRIDES_JSON={}
AI_PRICING_PROVIDER=openai
AI_PRICING_MODEL=gpt-5.6-terra
AI_PRICING_VERSION=openai-gpt-5.6-terra-standard-2026-07-30
AI_PRICING_CURRENCY=USD
AI_INPUT_COST_PER_MILLION_TOKENS=2
AI_CACHED_INPUT_COST_PER_MILLION_TOKENS=0.2
AI_OUTPUT_COST_PER_MILLION_TOKENS=12
AI_LONG_CONTEXT_THRESHOLD_TOKENS=272000
AI_LONG_CONTEXT_INPUT_MULTIPLIER=2
AI_LONG_CONTEXT_OUTPUT_MULTIPLIER=1.5
AI_PRICING_EFFECTIVE_FROM=2026-07-30T00:00:00.000Z

# ---------------------------------------------------------------------------
# Test-only (optional). Tests never make paid provider calls.
# ---------------------------------------------------------------------------
# Run integration and E2E tests against a separate database:
# TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_career_assistant_test?schema=public
# Use a preinstalled Chromium build instead of Playwright's own:
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/path/to/chrome
