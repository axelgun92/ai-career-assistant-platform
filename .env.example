DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_career_assistant?schema=public
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
AI_MODEL=gpt-5.6-terra
AI_MAX_OUTPUT_TOKENS=12000
AI_RETRY_LIMIT=1
AI_CALL_BUDGET=16
AI_REQUEST_TIMEOUT_MS=120000
AI_PRICING_PROVIDER=openai
AI_PRICING_MODEL=gpt-5.6-terra
AI_PRICING_VERSION=openai-gpt-5.6-terra-standard-2026-07-30
AI_PRICING_CURRENCY=USD
AI_INPUT_COST_PER_MILLION_TOKENS=2
AI_CACHED_INPUT_COST_PER_MILLION_TOKENS=0.2
AI_OUTPUT_COST_PER_MILLION_TOKENS=12
AI_LONG_CONTEXT_THRESHOLD_TOKENS=272000
AI_LONG_CONTEXT_INPUT_MULTIPLIER=2
AI_LONG_CONTEXT_OUTPUT_MULTIPLIER=1.5
AI_PRICING_EFFECTIVE_FROM=2026-07-30T00:00:00.000Z
EVALUATION_JOB_MAX_ATTEMPTS=3
EVALUATION_JOB_LEASE_SECONDS=300
EVALUATION_WORKER_POLL_MS=1000
